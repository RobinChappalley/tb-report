graph TB
    subgraph "Internet"
        User((Utilisateur))
        LE[Let's Encrypt CA]
    end

    subgraph "VM Infomaniak (Docker Host)"
        DS[(Docker Socket)]
        
        subgraph "Infrastructure de Reverse Proxy"
            NP[nginx-proxy]
            AC[acme-companion]
            VolC[(Volume: Certificats)]
        end

        subgraph "Application"
            IP[imgproxy]
        end
    end

    %% Flux de détection (Automatique)
    IP -- "1. Déclare VIRTUAL_HOST & LETSENCRYPT_HOST" --> DS
    DS -- "2. Notifie l'événement" --> NP
    DS -- "2. Notifie l'événement" --> AC

    %% Flux de configuration et SSL
    AC -- "3. Vérifie le domaine" <--> LE
    AC -- "4. Stocke les certificats" --> VolC
    VolC -- "5. Lit les certificats" --> NP
    NP -- "6. Génère la config Nginx" --> NP

    %% Flux de requête (Utilisateur)
    User -- "7. HTTPS (port 443)" --> NP
    NP -- "8. Proxy pass (port 8080)" --> IP
