{
  "name": "lt-website",
  "version": "1.7.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "scripts": {
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
