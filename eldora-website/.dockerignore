# Application
/web/app/plugins/*
!/web/app/plugins/.gitkeep
/web/app/mu-plugins/*/
/web/app/upgrade
/web/app/uploads/*
!/web/app/uploads/.gitkeep
/web/app/cache/*

# Ignore directories & files generated node
/node_modules/
/web/app/custom-plugins/**/node_modules/

# WordPress
/web/wp/

# Dumps
*.sql

# Docker
/Dockerfile
/.docker*
/docker-compose.*

# Logs and caches
*.log
/.phpcs-cache

# Dotenv
/.env
/.env.*

# Composer
/vendor/
/web/app/custom-plugins/vendor/
/web/app/themes/*/vendor/
/tools/*/vendor/

# Ignore files generated by OS and developers' tools
/.idea
/.vscode
*.DS_Store
