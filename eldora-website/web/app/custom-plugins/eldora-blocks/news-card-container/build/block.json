{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "eldora/news-card-container",
  "version": "0.1.0",
  "title": "Cartes d'actualités",
  "category": "media",
  "icon": "megaphone",
  "description": "Bloc conteneur de cartes d'actualités pour Guttenberg.",
  "example": {},
  "supports": {
    "html": false
  },
  "attributes": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "default": "Actualités"
    },
    "show": {
      "type": "string",
      "default": "Voir toutes les actualités"
    }
  },
  "render": "file:./render.php",
  "textdomain": "eldora",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js"
}