{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "eldora/pole-card",
  "version": "0.1.0",
  "title": "Carte pôle",
  "category": "text",
  "icon": "format-aside",
  "description": "Bloc carte pôle pour Guttenberg.",
  "example": {},
  "supports": {
    "html": false
  },
  "attributes": {
    "id": {
      "type": "string"
    },
    "logo": {
      "enum": ["school-fr", "entreprise-fr", "health-fr", "education-fr", "school-de", "entreprise-de", "health-de", "education-de"],
      "default": "school-fr"
    },
    "text": {
      "type": "string"
    },
    "link": {
      "type": "string"
    }
  },
  "textdomain": "eldora",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js"
}
