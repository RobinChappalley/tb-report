{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "eldora/text-image-grid",
  "version": "0.1.0",
  "title": "Grand teaser",
  "category": "media",
  "icon": "format-image",
  "description": "Bloc grand teaser pour Guttenberg.",
  "example": {},
  "supports": {
    "html": false
  },
  "attributes": {
    "id": {
      "type": "string"
    },
    "surtitle": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "link": {
      "type": "object"
    },
    "format": {
      "type": "enum",
      "default": "one-image-right",
      "enum": [
        "one-image-right",
        "one-image-left",
        "four-images"
      ]
    },
    "images": {
      "type": "array",
      "default": []
    }
  },
  "textdomain": "eldora",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js"
}