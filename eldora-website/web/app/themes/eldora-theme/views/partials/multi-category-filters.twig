<div class="xl:col-span-10 xl:col-start-2 mb-8"
     x-data="{
         selectedCategories: {},
         openDropdown: null,
         mobileModalOpen: false,
         toggleCategory(parentSlug, childSlug) {
             if (!this.selectedCategories[parentSlug]) {
                 this.selectedCategories[parentSlug] = [];
             }
             const idx = this.selectedCategories[parentSlug].indexOf(childSlug);
             if (idx > -1) {
                 this.selectedCategories[parentSlug].splice(idx, 1);
             } else {
                 this.selectedCategories[parentSlug].push(childSlug);
             }
             this.filterPosts();
         },
         isSelected(parentSlug, childSlug) {
             return this.selectedCategories[parentSlug] && this.selectedCategories[parentSlug].includes(childSlug);
         },
         countSelected(parentSlug) {
             return this.selectedCategories[parentSlug] ? this.selectedCategories[parentSlug].length : 0;
         },
         toggleDropdown(slug) {
             this.openDropdown = this.openDropdown === slug ? null : slug;
         },
         filterPosts() {
             let url = window.location.href;
             url = url.replace(/\/page\/\d+\//g, '/');
             urlObj = new URL(url);

             // Clear all filter params
             urlObj.searchParams.delete('category');
             {% for category_data in all_parent_categories %}
             urlObj.searchParams.delete('{{ category_data.parent.slug }}');
             {% endfor %}

             // Set params from selectedCategories
             for (let parentSlug in this.selectedCategories) {
                 const values = this.selectedCategories[parentSlug];
                 if (values && values.length > 0) {
                     urlObj.searchParams.set(parentSlug, values.join(','));
                 }
             }

             urlObj.searchParams.delete('paged');
             urlObj.searchParams.delete('page');

             window.location.href = urlObj.toString();
         },
         applyFiltersAndClose() {
             this.filterPosts();
             this.mobileModalOpen = false;
         },
         resetFilters() {
             window.location.href = window.location.pathname;
         }
     }"
     x-effect="document.body.style.overflow = mobileModalOpen ? 'hidden' : ''"
     x-init="
         urlParams = new URLSearchParams(window.location.search);

         {% for category_data in all_parent_categories %}
             paramValue = urlParams.get('{{ category_data.parent.slug }}') || '';
             selectedCategories['{{ category_data.parent.slug }}'] = paramValue ? paramValue.split(',') : [];

             // Legacy 'category' parameter backward compatibility
             if (selectedCategories['{{ category_data.parent.slug }}'].length === 0 && urlParams.get('category')) {
                 {% for child in category_data.children %}
                 if (urlParams.get('category') === '{{ child.slug }}') {
                     selectedCategories['{{ category_data.parent.slug }}'] = ['{{ child.slug }}'];
                 }
                 {% endfor %}
             }
         {% endfor %}
     "
    >
    {% if all_parent_categories|length > 0 %}
        {# Mobile: Filter button #}
        <div class="md:hidden">
            <button
                x-on:click="mobileModalOpen = true"
                class="w-full px-6 py-4 bg-eldora-700 rounded-md text-white font-medium text-base flex items-center justify-between"
            >
                <span>{{ __('blog.filters.title', 'eldora-theme') }}</span>
                <svg class="size-8">
                    <use xlink:href="{{ theme.link }}/assets/icons/icons.svg#plus" />
                </svg>
            </button>
        </div>

        {# Desktop: Dropdown checkboxes #}
        <div class="hidden md:flex flex-wrap gap-4">
            {% for category_data in all_parent_categories %}
                {% if category_data.children|length > 0 %}
                    <div class="relative" @click.away="openDropdown === '{{ category_data.parent.slug }}' && (openDropdown = null)">
                        {# Trigger button #}
                        <button
                            @click="toggleDropdown('{{ category_data.parent.slug }}')"
                            class="h-fit rounded-md py-3.5 px-4 text-base font-medium flex items-center gap-2 transition-colors duration-200 cursor-pointer"
                            :class="openDropdown === '{{ category_data.parent.slug }}' || countSelected('{{ category_data.parent.slug }}') > 0
                                ? 'bg-eldora-500 border border-eldora-50'
                                : 'bg-eldora-700'"
                        >
                            <span>{{ category_data.parent.name }}</span>
                            <span x-show="countSelected('{{ category_data.parent.slug }}') > 0"
                                  x-text="'(' + countSelected('{{ category_data.parent.slug }}') + ')'"
                                  class="text-sm"></span>
                            <svg class="size-4 transition-transform duration-200"
                                 :class="openDropdown === '{{ category_data.parent.slug }}' ? 'rotate-180' : ''">
                                <use xlink:href="{{ theme.link }}/assets/icons/icons.svg#arrow-down-white" />
                            </svg>
                        </button>

                        {# Dropdown panel #}
                        <div x-show="openDropdown === '{{ category_data.parent.slug }}'"
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 -translate-y-1"
                             x-transition:enter-end="opacity-100 translate-y-0"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 translate-y-0"
                             x-transition:leave-end="opacity-0 -translate-y-1"
                             x-cloak
                             class="absolute z-30 mt-2 w-[240px] bg-eldora-700 rounded-lg py-4 px-4 shadow-lg"
                             style="background: linear-gradient(180deg, #1e232d 0%, var(--color-eldora-700) 100%);">
                            <div class="space-y-5">
                                {% for child in category_data.children %}
                                    <label class="flex items-center gap-3 cursor-pointer group"
                                           @click.prevent="toggleCategory('{{ category_data.parent.slug }}', '{{ child.slug }}')">
                                        {# Custom checkbox #}
                                        <span class="size-5 rounded border-2 flex items-center justify-center shrink-0 transition-colors duration-150"
                                              :class="isSelected('{{ category_data.parent.slug }}', '{{ child.slug }}')
                                                  ? 'bg-[#80BA27] border-[#80BA27]'
                                                  : 'border-gray-400 bg-transparent'">
                                            <svg x-show="isSelected('{{ category_data.parent.slug }}', '{{ child.slug }}')"
                                                 class="size-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                            </svg>
                                        </span>
                                        <span class="text-sm">{{ child.name }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
            <button
                @click="resetFilters()"
                class="px-4 py-3.5 bg-eldora-700 hover:bg-eldora-600 text-white rounded-md text-sm font-medium transition-colors duration-200 cursor-pointer"
            >
                {{ __('blog.filters.reset', 'eldora-theme') }}
            </button>
        </div>

        {# Mobile Modal #}
        <div x-show="mobileModalOpen"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 z-50 bg-eldora-700 md:hidden flex flex-col mr-6"
             x-cloak>
            {# Header #}
            <div class="flex items-center justify-between p-4">
                <h2 class="text-xl font-bricolage font-bold">{{ __('blog.filters.title', 'eldora-theme') }}</h2>
                <button x-on:click="mobileModalOpen = false" class="p-2">
                    <svg class="w-4 h-4">
                        <use xlink:href="{{ theme.link }}/assets/icons/icons.svg#close" />
                    </svg>
                </button>
            </div>

            {# Filter content #}
            <div class="flex-1 overflow-y-auto p-4 space-y-11">
                {% for category_data in all_parent_categories %}
                    {% if category_data.children|length > 0 %}
                        <div class="filter-category">
                            <h3 class="font-semibold font-bricolage text-lg mb-4 text-gray-900">{{ category_data.parent.name }}</h3>
                            <div class="space-y-5">
                                {% for child in category_data.children %}
                                    <label class="flex items-center gap-3 cursor-pointer"
                                           @click.prevent="toggleCategory('{{ category_data.parent.slug }}', '{{ child.slug }}')">
                                        {# Custom checkbox #}
                                        <span class="size-5 rounded border-2 flex items-center justify-center shrink-0 transition-colors duration-150"
                                              :class="isSelected('{{ category_data.parent.slug }}', '{{ child.slug }}')
                                                  ? 'bg-[#80BA27] border-[#80BA27]'
                                                  : 'border-gray-400 bg-transparent'">
                                            <svg x-show="isSelected('{{ category_data.parent.slug }}', '{{ child.slug }}')"
                                                 class="size-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                            </svg>
                                        </span>
                                        <span>{{ child.name }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            {# Footer #}
            <div class="p-4 space-y-3">
                <button
                    x-on:click="applyFiltersAndClose()"
                    class="w-full px-6 py-3 bg-theme-500 hover:bg-theme-600 text-white rounded-md font-medium transition-colors duration-200"
                >
                    {{ __('blog.filters.apply', 'eldora-theme') }}
                </button>
                <button
                    @click="resetFilters()"
                    class="w-full px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-md font-medium transition-colors duration-200"
                >
                    {{ __('blog.filters.reset', 'eldora-theme') }}
                </button>
            </div>
        </div>
    {% endif %}
</div>