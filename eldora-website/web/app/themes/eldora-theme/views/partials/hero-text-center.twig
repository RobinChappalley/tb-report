<div class="container-grid max-xl:px-4 mt-12 xl:mt-23 mb-18 xl:mb-24">
  <div class="text-center">
    <div class="flex justify-center">
      {% include 'partials/breadcrumbs.twig' %}
    </div>

    {% if post.hero_title %}
      <h1 class="h2 mt-10">{{ post.hero_title }}</h1>
      {% if post.hero_text %}
        <div class="mt-6 text-lg max-w-[665px] mx-auto">{{ post.hero_text }}</div>
      {% endif %}
    {% elseif fn('is_post_type_archive') %}
      {% set post_type = fn('get_post_type') %}
      <h1 class="h2 mt-10">{{ __(post_type ~ '.archive-page.title', 'eldora-theme') }}</h1>
      {% set description = __(post_type ~ '.archive-page.description', 'eldora-theme') %}
      {% if description and description != post_type ~ '.archive-page.description' %}
        <div class="mt-6 text-lg max-w-[665px] mx-auto">{{ description }}</div>
      {% endif %}
    {% endif %}
  </div>
</div>
