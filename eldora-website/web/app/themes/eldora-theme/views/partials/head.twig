    <script>
      window.leckerliSettings = {
        banner: {
          title: "{{ __('leckerli.title', 'eldora-theme') }}",
          description: "{{ __('leckerli.description', 'eldora-theme') }}",
          accept: "{{ __('leckerli.accept', 'eldora-theme') }}",
          reject: "{{ __('leckerli.reject', 'eldora-theme') }}",
          customise: "{{ __('leckerli.customise', 'eldora-theme') }}",
