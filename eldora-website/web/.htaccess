<IfModule mod_rewrite.c>
RewriteEngine on

RewriteRule ^fr/medias-2021/les-articles-de-presse-2021/?$ https://www.eldora.ch/eldora/medias/presse [L,R=302,NC]
RewriteRule ^fr/medias-2021/les-publications-2021/?$ https://www.eldora.ch/eldora/medias/nos-publications [L,R=302,NC]
RewriteRule ^fr/medias-2021 https://www.eldora.ch/eldora/medias [L,R=302,NC]
RewriteRule ^fr/a-propos-2021 https://www.eldora.ch/eldora/notre-marque-de-fabrique [L,R=302,NC]
RewriteRule ^fr/carriere/nos-metiers-cuisinier-polyvalent-etc-se-presentent-2021/?$ https://www.eldora.ch/eldora/gestion-des-talents/presentation-des-metiers [L,R=302,NC]
RewriteRule ^fr/carriere https://www.eldora.ch/eldora/gestion-des-talents [L,R=302,NC]
RewriteRule ^fr/competences-2021/enseignement-2021 https://www.eldora.ch/secteur/enseignement [L,R=302,NC]
RewriteRule ^fr/competences-2021/entreprise-2021 https://www.eldora.ch/secteur/entreprise [L,R=302,NC]
RewriteRule ^fr/competences-2021/sante-2021 https://www.eldora.ch/secteur/sante [L,R=302,NC]
RewriteRule ^fr/contact-2021/?$ https://www.eldora.ch/eldora/contact [L,R=302,NC]
RewriteRule ^fr/digital-2021/eldora-tv-2021/?$ https://www.eldora.ch/eldora/medias/eldora-tv [L,R=302,NC]
RewriteRule ^fr/digital-2021/facebook-2021/?$ https://www.eldora.ch/eldora/medias/reseaux-sociaux [L,R=302,NC]
RewriteRule ^fr/digital-2021/les-recettes-2021/?$ https://www.eldora.ch/eldora/medias/actualites [L,R=302,NC]
RewriteRule ^fr/digital-2021 https://www.eldora.ch/eldora/medias [L,R=302,NC]
RewriteRule ^fr/durabilite/certifications/?$ https://www.eldora.ch/eldora/engagement-responsable/certificats-et-labels [L,R=302,NC]
RewriteRule ^fr/durabilite https://www.eldora.ch/eldora/engagement-responsable [L,R=302,NC]
RewriteRule ^fr/engagements/les-certifications/?$ https://www.eldora.ch/eldora/engagement-responsable/certificats-et-labels [L,R=302,NC]
RewriteRule ^fr/engagements/?$ https://www.eldora.ch/eldora/engagement-responsable [L,R=302,NC]
RewriteRule ^fr https://www.eldora.ch/ [L,R=302,NC]

RewriteCond %{ENV:WP_ENV} ^production$
RewriteCond %{HTTP_HOST} ^(www.)?de.eldora.ch$ [NC]
RewriteRule ^(.*)$ https://www.eldora.ch/de/$1 [L,R=302]

RewriteCond %{ENV:WP_ENV} ^production$
RewriteCond %{HTTP_HOST} !^www.eldora.ch$ [NC]
RewriteRule ^(.*)$ https://www.eldora.ch/$1 [L,R=302]

RewriteCond %{ENV:WP_ENV} ^production$
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=302]
</IfModule>

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
