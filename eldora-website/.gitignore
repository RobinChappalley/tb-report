# Application
/web/app/plugins/*
!/web/app/plugins/.gitkeep
/web/app/mu-plugins/*/
/web/app/upgrade
/web/app/uploads/*
!/web/app/uploads/.gitkeep
/web/app/cache/*
/web/app/languages

# Ignore directories & files generated node
/node_modules/
/web/app/custom-plugins/**/node_modules/

# WordPress
/web/wp/

# Dumps
*.sql

# Docker
/docker-compose.override.yml

# Logs and caches
*.log
/.phpcs-cache

# Dotenv
/.env
/.env.*
/!.env.example
/!.env.ci

# Composer
/vendor/
/web/app/custom-plugins/*/vendor/
/web/app/themes/*/vendor/
/tools/*/vendor/

# WP-CLI
/wp-cli.local.yml

# Ignore files generated by OS and developers' tools
/.idea/
/.vscode/
*.DS_Store
