%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryTextColor': '#000000', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'secondaryColor': '#f5f5f5', 'tertiaryColor': '#ffffff', 'background': '#ffffff'}, 'flowchart': {'htmlLabels': true, 'curve': 'basis'}}}%%
flowchart TD
    client["Client<br/>Requête d'image"]
    proxy["nginx-proxy<br/>Trafic entrant : ports 443 / 80"]
    cache["nginx-cache<br/>Cache HTTP des images redimensionnées"]
    decision{"Image en cache<br/>et valide ?"}
    hit["HIT<br/>Servir directement depuis le cache<br/><small>sans appeler imgproxy</small>"]
    imgproxy["imgproxy<br/>Traiter et redimensionner<br/>l'image à la volée"]
    store["nginx-cache<br/>Stocker la réponse d'image"]

    client -->|Requête| proxy
    proxy -->|Transmettre| cache
    cache --> decision
    decision -->|HIT| hit
    decision -->|MISS| imgproxy
    hit -->|Réponse depuis le cache| proxy
    imgproxy -->|Image traitée| store
    store -->|Réponse mise en cache| proxy
    proxy -->|Réponse| client

    classDef service fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1.5px;
    classDef decision fill:#f5f5f5,stroke:#000000,color:#000000,stroke-width:1.5px;
    classDef path fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1.5px;
    class client,proxy,cache,imgproxy,store service;
    class decision decision;
    class hit path;
