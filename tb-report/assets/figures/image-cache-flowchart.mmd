%% Image delivery flow: cache HIT vs cache MISS
flowchart LR
    client[Client] --> proxy[Proxy]
    proxy --> cache[nginx-cache]

    cache -->|CACHE HIT · serve cached image| proxy
    cache -->|CACHE MISS · fetch original| imgproxy[imgproxy]
    imgproxy -->|processed image| cache
    cache -->|write cache + return image| proxy

    proxy --> client

    %% Neutral request/response links
    linkStyle 0,1,6 stroke:#64748b,stroke-width:2px,color:#334155
    %% HIT path: green solid arrow
    linkStyle 2 stroke:#16a34a,stroke-width:3px,color:#15803d
    %% MISS path: orange dashed arrows
    linkStyle 3,4,5 stroke:#ea580c,stroke-width:3px,stroke-dasharray:7 4,color:#c2410c

    classDef service fill:#0f172a,stroke:#334155,color:#f8fafc,stroke-width:2px
    classDef cache fill:#0b3b4a,stroke:#0891b2,color:#ecfeff,stroke-width:2px
    classDef endpoint fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:2px
    classDef processor fill:#431407,stroke:#f97316,color:#fff7ed,stroke-width:2px

    class proxy service
    class cache cache
    class client endpoint
    class imgproxy processor
